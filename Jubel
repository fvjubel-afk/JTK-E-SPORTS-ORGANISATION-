<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Esports Standings Generator</title>

<style>
:root {
  --bg: #090817;
  --panel: #17132f;
  --gold: #ffbf19;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: white;
  font-family: Arial, sans-serif;
}

header {
  padding: 18px;
  background: #100d23;
  color: var(--gold);
  font-weight: bold;
}

.app {
  display: grid;
  grid-template-columns: 400px 1fr;
  min-height: 100vh;
}

.controls {
  padding: 15px;
  background: #100d23;
}

.section {
  background: var(--panel);
  border: 1px solid #342b5e;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 12px;
}

h2 {
  color: var(--gold);
  font-size: 14px;
}

label {
  display: block;
  margin: 10px 0 5px;
  color: #aaa3c7;
  font-size: 12px;
}

input, textarea {
  width: 100%;
  padding: 10px;
  background: #0c0a1c;
  color: white;
  border: 1px solid #3b3265;
  border-radius: 7px;
}

textarea {
  height: 160px;
}

button {
  padding: 11px;
  border: 0;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
}

.primary {
  width: 100%;
  background: linear-gradient(90deg,#ffd42b,#ff9700);
}

.designs {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 6px;
}

.design {
  background: #29214e;
  color: white;
}

.design.active {
  background: var(--gold);
  color: black;
}

.preview-area {
  padding: 20px;
  display: flex;
  justify-content: center;
  background: #090817;
}

#poster {
  width: 100%;
  max-width: 850px;
  aspect-ratio: 4/3;
  padding: 25px;
  display: flex;
  flex-direction: column;
  gap: 15px;
  color: var(--ink);
  background: var(--paper);
  font-family: Arial, sans-serif;
}

.poster-head {
  text-align: center;
}

.org {
  font-weight: bold;
  font-size: 16px;
}

.event {
  font-size: 40px;
  font-weight: 1000;
}

.subevent {
  font-size: 20px;
  font-weight: bold;
}

.table-title {
  text-align: center;
  padding: 10px;
  background: var(--accent);
  color: black;
  font-weight: bold;
}

.table-holder {
  flex: 1;
  overflow: hidden;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: var(--table);
  color: var(--ink);
  text-align: center;
}

th {
  padding: 10px 5px;
  background: var(--accent);
  color: black;
}

td {
  padding: 8px 5px;
  font-weight: bold;
  border-bottom: 1px solid #aaa5;
}

tbody tr:nth-child(even) {
  background: var(--row);
}

.team {
  text-align: left;
}

.footer {
  display: flex;
  justify-content: space-between;
  font-weight: bold;
}

/* 8 DESIGNS */

#poster.design1 {
  --paper: linear-gradient(145deg,#071b31,#0b4a51,#e0c77c);
  --ink: white;
  --accent: #ffd34e;
  --table: #eaffdc;
  --row: #d7f4c9;
}

#poster.design2 {
  --paper: linear-gradient(160deg,#d9f5ff,#fff7d9);
  --ink: #173b26;
  --accent: #226b35;
  --table: #f4ffe9;
  --row: #d9efc8;
}

#poster.design3 {
  --paper: linear-gradient(135deg,#210d45,#642c9a);
  --ink: white;
  --accent: #ffcf37;
  --table: #21123d;
  --row: #38205b;
}

#poster.design4 {
  --paper: linear-gradient(135deg,#10151f,#353b49);
  --ink: white;
  --accent: #ff5c36;
  --table: #222a36;
  --row: #303b4b;
}

#poster.design5 {
  --paper: linear-gradient(145deg,#fff1e4,#f5b6a1);
  --ink: #502b28;
  --accent: #a83d35;
  --table: #fff8f0;
  --row: #f8ddd0;
}

#poster.design6 {
  --paper: linear-gradient(135deg,#061e35,#086a9a);
  --ink: white;
  --accent: #6ceaff;
  --table: #eafaff;
  --row: #cdeefa;
}

#poster.design7 {
  --paper: linear-gradient(135deg,#171717,#4d3a12);
  --ink: #fff4ce;
  --accent: #ffc928;
  --table: #2b2619;
  --row: #43391d;
}

#poster.design8 {
  --paper: linear-gradient(135deg,#f7f2ff,#d6d5ff);
  --ink: #29234d;
  --accent: #5745a4;
  --table: white;
  --row: #e9e5ff;
}

@media(max-width:850px) {
  .app {
    grid-template-columns: 1fr;
  }

  .preview-area {
    padding: 10px;
  }

  #poster {
    min-height: 320px;
    padding: 15px;
  }

  .event {
    font-size: 25px;
  }
}
</style>
</head>

<body>

<header>
⚡ ESPORTS STANDINGS GENERATOR
</header>

<div class="app">

<aside class="controls">

<div class="section">
<h2>DESIGN SELECT</h2>
<div class="designs" id="designs"></div>
</div>

<div class="section">
<h2>EVENT DETAILS</h2>

<label>Organization Name</label>
<input id="org" value="JTK X TST E-SPORTS ORGANISATION">

<label>Event Name</label>
<input id="event" value="CHAMPION RUSH">

<label>Sub Event</label>
<input id="subevent" value="3 PM">

<label>Week / Day</label>
<input id="week" value="WEEK 00 DAY 00">

<label>Footer Left</label>
<input id="footleft" value="JTK E-SPORTS">

<label>Footer Right</label>
<input id="footright" value="FREE FIRE MAX">
</div>

<div class="section">
<h2>POINT SETTINGS</h2>

<label>Placement Points</label>
<input id="placement"
value="12,9,8,7,6,5,4,3,2,1,0,0">

<label>Points Per Kill</label>
<input id="killpoint" type="number" value="1">
</div>

<div class="section">
<h2>MATCH DATA INPUT</h2>

<textarea id="data">VX ESPORTS,1,8,3,5,2,4
TECTON,2,6,1,5,4,2
BOC,3,5,2,6,3,4
TR7,4,4,5,3,1,7
THE 4 RIVALS,5,3,4,5,2,6
RX7,6,5,6,4,3,4
BXR,7,4,3,6,5,3
NoRemorse,8,3,7,4,6,5
RTH,9,2,8,3,7,4
THRIVE ARENA,10,3,9,2,8,4</textarea>

<br><br>
<button class="primary" onclick="update()">
AUTO CALCULATE
</button>
</div>

<div class="section">
<h2>DOWNLOAD</h2>
<button class="primary" onclick="downloadPNG()">
DOWNLOAD PNG
</button>
</div>

</aside>

<main class="preview-area">

<section id="poster" class="design2">

<div class="poster-head">
<div class="org" id="porg"></div>
<div class="event" id="pevent"></div>
<div class="subevent" id="psubevent"></div>
<div id="pweek"></div>
</div>

<div class="table-title">
★ OVERALL STANDINGS ★
</div>

<div class="table-holder">
<table id="standings">

<thead>
<tr>
<th>RANK</th>
<th>TEAM NAME</th>
<th>PLACE P.</th>
<th>KILL P.</th>
<th>TOTAL P.</th>
</tr>
</thead>

<tbody></tbody>

</table>
</div>

<div class="footer">
<span id="pfootleft"></span>
<span id="pfootright"></span>
</div>

</section>

</main>
</div>

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

<script>

const $ = id => document.getElementById(id);

/* 8 DESIGN BUTTONS */

for(let i=1;i<=8;i++){

let btn=document.createElement("button");

btn.className="design";
btn.innerText="Design "+i;

if(i===2) btn.classList.add("active");

btn.onclick=()=>{

$("poster").className="design"+i;

document.querySelectorAll(".design")
.forEach(b=>b.classList.remove("active"));

btn.classList.add("active");

};

$("designs").appendChild(btn);

}

/* AUTO POINT CALCULATION */

function update(){

$("porg").innerText=$("org").value;
$("pevent").innerText=$("event").value;
$("psubevent").innerText=$("subevent").value;
$("pweek").innerText=$("week").value;

$("pfootleft").innerText=$("footleft").value;
$("pfootright").innerText=$("footright").value;

let placement=$("placement").value
.split(",").map(Number);

let killPoint=Number($("killpoint").value)||0;

let lines=$("data").value
.split("\n")
.filter(x=>x.trim());

let teams=[];

lines.forEach(line=>{

let parts=line.split(",").map(x=>x.trim());

let name=parts.shift();

let place=0;
let kills=0;

for(let i=0;i<parts.length;i+=2){

let pos=Number(parts[i]);
let kill=Number(parts[i+1]||0);

if(pos>=1 && pos<=placement.length){
place+=placement[pos-1]||0;
}

if(kill>0){
kills+=kill;
}

}

teams.push({
name,
place,
kills,
total:place+(kills*killPoint)
});

});

/* SORT RANKING */

teams.sort((a,b)=>
b.total-a.total ||
b.kills-a.kills
);

/* TABLE UPDATE */

let tbody=$("standings").querySelector("tbody");

tbody.innerHTML="";

teams.forEach((team,index)=>{

let tr=document.createElement("tr");

let rank=["🥇","🥈","🥉"][index]||index+1;

let values=[
rank,
team.name,
team.place,
team.kills*killPoint,
team.total
];

values.forEach((value,i)=>{

let td=document.createElement("td");

td.innerText=value;

if(i===1){
td.className="team";
}

tr.appendChild(td);

});

tbody.appendChild(tr);

});

}

/* LIVE PREVIEW */

[
"org",
"event",
"subevent",
"week",
"footleft",
"footright",
"placement",
"killpoint",
"data"
].forEach(id=>{

$(id).addEventListener("input",update);

});

/* PNG DOWNLOAD */

async function downloadPNG(){

if(!window.html2canvas){
alert("Internet connection চালু করুন এবং Refresh দিন।");
return;
}

let canvas=await html2canvas($("poster"),{
scale:3,
backgroundColor:null
});

let link=document.createElement("a");

link.download="ESPORTS-POINT-TABLE.png";

link.href=canvas.toDataURL("image/png");

link.click();

}

update();

</script>

</body>
</html>
